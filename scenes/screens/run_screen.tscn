[gd_scene format=3]
[ext_resource type="Script" path="res://scripts/ui/run_screen.gd" id="script"]
[ext_resource type="Theme" path="res://assets/ui/demo_theme.tres" id="theme"]
[node name="RunScreen" type="Control"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("theme")
script = ExtResource("script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 96
theme_override_constants/margin_right = 96
theme_override_constants/margin_top = 56
theme_override_constants/margin_bottom = 56

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Title" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 56
text = "DEMO_ROUTE_TITLE"

[node name="Status" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 40

[node name="Health" type="Label" parent="Margin/Layout/Status"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 26
theme_override_colors/font_color = Color(0.57, 0.85, 0.71, 1)

[node name="DeckCount" type="Label" parent="Margin/Layout/Status"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 26

[node name="Body" type="VBoxContainer" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 24

[node name="Footer" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2

[node name="Menu" type="Button" parent="Margin/Layout/Footer"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(260, 62)
text = "MAIN_MENU"

[node name="Spacer" type="Control" parent="Margin/Layout/Footer"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Settings" type="Button" parent="Margin/Layout/Footer"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(220, 62)
text = "SETTINGS"
