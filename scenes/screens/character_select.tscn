[gd_scene format=3]
[ext_resource type="Script" path="res://scripts/ui/character_select.gd" id="script"]
[ext_resource type="Theme" path="res://assets/ui/demo_theme.tres" id="theme"]

[ext_resource type="PackedScene" path="res://scenes/components/knight_portrait.tscn" id="portrait"]
[node name="CharacterSelect" type="Control"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("theme")
script = ExtResource("script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 80
theme_override_constants/margin_right = 80
theme_override_constants/margin_top = 36
theme_override_constants/margin_bottom = 36

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Eyebrow" type="Label" parent="Margin/Layout"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 22
text = "PREPARE"


[node name="Title" type="Label" parent="Margin/Layout"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 64
text = "The Knight"


[node name="Body" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 56

[node name="Hero" type="VBoxContainer" parent="Margin/Layout/Body"]
layout_mode = 2
custom_minimum_size = Vector2(620, 0)

[node name="Portrait" parent="Margin/Layout/Body/Hero" instance=ExtResource("portrait")]
layout_mode = 2

[node name="Stats" type="Label" parent="Margin/Layout/Body/Hero"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 30
text = "KNIGHT_STATS"


[node name="Passive" type="Label" parent="Margin/Layout/Body/Hero"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 24
text = "KNIGHT_DESCRIPTION"
autowrap_mode = 2
size_flags_vertical = 3

[node name="OptionsPanel" type="PanelContainer" parent="Margin/Layout/Body"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Options" type="VBoxContainer" parent="Margin/Layout/Body/OptionsPanel"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="DeckHeading" type="Label" parent="Margin/Layout/Body/OptionsPanel/Options"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 22
text = "CHOOSE_DECK"


[node name="DeckChoice" type="OptionButton" parent="Margin/Layout/Body/OptionsPanel/Options"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 68)

[node name="RouteHeading" type="Label" parent="Margin/Layout/Body/OptionsPanel/Options"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 22
text = "DEMO_ROUTE_TITLE"


[node name="Route" type="Label" parent="Margin/Layout/Body/OptionsPanel/Options"]
unique_name_in_owner = true
layout_mode = 2
text = ""
autowrap_mode = 2
max_lines_visible = 4
text_overrun_behavior = 3
theme_override_font_sizes/font_size = 25

[node name="Spacer" type="Control" parent="Margin/Layout/Body/OptionsPanel/Options"]
layout_mode = 2
size_flags_vertical = 3

[node name="Validation" type="Label" parent="Margin/Layout/Body/OptionsPanel/Options"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 22
text = ""
autowrap_mode = 2
theme_override_colors/font_color = Color(0.91, 0.61, 0.51, 1)

[node name="Start" type="Button" parent="Margin/Layout/Body/OptionsPanel/Options"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 62)
mouse_default_cursor_shape = 2
text = "START_DEMO"


[node name="Footer" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2

[node name="Back" type="Button" parent="Margin/Layout/Footer"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 62)
mouse_default_cursor_shape = 2
text = "BACK"


[node name="Spacer" type="Control" parent="Margin/Layout/Footer"]
layout_mode = 2
size_flags_horizontal = 3

[node name="EditDeck" type="Button" parent="Margin/Layout/Footer"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 62)
mouse_default_cursor_shape = 2
text = "EDIT_DECK"
