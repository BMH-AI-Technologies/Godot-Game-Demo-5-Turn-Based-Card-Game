[gd_scene format=3]
[ext_resource type="PackedScene" path="res://scenes/screens/run_screen.tscn" id="base"]
[ext_resource type="Script" path="res://scripts/ui/demo_map.gd" id="script"]
[node name="DemoMap" instance=ExtResource("base")]
script = ExtResource("script")

[node name="RouteScroll" type="ScrollContainer" parent="Margin/Layout/Body"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
vertical_scroll_mode = 0

[node name="Center" type="CenterContainer" parent="Margin/Layout/Body/RouteScroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Route" type="HBoxContainer" parent="Margin/Layout/Body/RouteScroll/Center"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 24
