[gd_scene format=3]
[ext_resource type="Script" path="res://scripts/ui/deck_screen.gd" id="script"]
[ext_resource type="Script" path="res://scripts/ui/deck_drop_zone.gd" id="drop"]
[ext_resource type="Theme" path="res://assets/ui/demo_theme.tres" id="theme"]

[node name="DeckEditor" type="Control"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("theme")
script = ExtResource("script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 44
theme_override_constants/margin_right = 44
theme_override_constants/margin_top = 28
theme_override_constants/margin_bottom = 28

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Header" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2

[node name="Title" type="Label" parent="Margin/Layout/Header"]
