[ext_resource type="PackedScene" path="res://scenes/components/draw_deck.tscn" id="draw_deck"]
[node name="Combat" type="Control"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("theme")
script = ExtResource("script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_right = 32
theme_override_constants/margin_top = 36
theme_override_constants/margin_bottom = 36

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Header" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2

[node name="Encounter" type="Label" parent="Margin/Layout/Header"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 26
text = ""
custom_minimum_size = Vector2(460, 0)

[node name="Center" type="VBoxContainer" parent="Margin/Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 0

[node name="Message" type="Label" parent="Margin/Layout/Header/Center"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
