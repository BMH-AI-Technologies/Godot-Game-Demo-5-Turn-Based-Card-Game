text_overrun_behavior = 3
custom_minimum_size = Vector2(0, 28)

[node name="Round" type="Label" parent="Margin/Layout/Header/Center"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 30
text = ""
size_flags_horizontal = 3
horizontal_alignment = 1


[node name="Pause" type="Button" parent="Margin/Layout/Header"]
unique_name_in_owner = true
layout_mode = 2
mouse_default_cursor_shape = 2
text = "PAUSE"
custom_minimum_size = Vector2(205, 62)

[node name="Arena" type="HBoxContainer" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
