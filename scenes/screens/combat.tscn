[gd_scene format=3]
[ext_resource type="Script" path="res://scripts/ui/combat_screen.gd" id="script"]
[ext_resource type="Theme" path="res://assets/ui/demo_theme.tres" id="theme"]

[ext_resource type="PackedScene" path="res://scenes/actors/hero/knight.tscn" id="knight"]
[ext_resource type="Script" path="res://scripts/ui/hand_view.gd" id="hand"]
[ext_resource type="Script" path="res://scripts/ui/combat_presenter.gd" id="presenter"]
