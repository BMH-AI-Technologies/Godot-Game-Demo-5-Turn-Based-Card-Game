[gd_scene format=3]
[ext_resource type="PackedScene" path="res://scenes/screens/run_screen.tscn" id="base"]
[ext_resource type="Script" path="res://scripts/ui/card_reward.gd" id="script"]
[node name="CardReward" instance=ExtResource("base")]
