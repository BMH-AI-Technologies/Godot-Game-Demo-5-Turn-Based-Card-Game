[gd_scene format=3]
[ext_resource type="Script" path="res://scripts/ui/mana_bar.gd" id="script"]
[sub_resource type="StyleBoxFlat" id="background"]
bg_color = Color(0.035, 0.075, 0.10, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.29, 0.43, 0.49, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_left = 3
corner_radius_bottom_right = 3
[sub_resource type="StyleBoxFlat" id="fill"]
bg_color = Color(0.35, 0.62, 0.78, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_left = 3
corner_radius_bottom_right = 3

[node name="ManaBar" type="ProgressBar"]
custom_minimum_size = Vector2(150, 20)
mouse_filter = 2
max_value = 10.0
step = 1.0
show_percentage = false
theme_override_styles/background = SubResource("background")
theme_override_styles/fill = SubResource("fill")
script = ExtResource("script")

[node name="Value" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchor_right = 0.1
anchor_bottom = 1.0
mouse_filter = 2
text = "0"
horizontal_alignment = 1
vertical_alignment = 1
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.98, 0.97, 0.91, 1)
theme_override_colors/font_shadow_color = Color(0.015, 0.03, 0.04, 0.9)
theme_override_constants/shadow_offset_x = 1
theme_override_constants/shadow_offset_y = 1
